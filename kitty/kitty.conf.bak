font_family JetBrainsMono Nerd Font
font_size 11
background_opacity 0.92
confirm_os_window_close 0
cursor_shape beam
enable_audio_bell no
inactive_text_alpha 0.85

hide_window_decorations yes
window_border_width 0
draw_minimal_borders no
window_margin_width 0
padding_width 10

cursor #fabd2f
cursor_text_color #1d2021

color0 #282828
color1 #cc241d
color2 #98971a
color3 #d79921
color4 #458588
color5 #b16286
color6 #689d6a
color7 #a89984

color8 #928374
color9 #fb4934
color10 #b8bb26
color11 #fabd2f
color12 #83a598
color13 #d3869b
color14 #8ec07c
color15 #fbf1c7

